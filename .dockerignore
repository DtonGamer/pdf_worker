# .dockerignore for PDF Processing Worker
# Exclude files that aren't needed in the Docker image to reduce size

# Git files
.git
.gitignore

# IDE files
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python cache files
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so

# Virtual environments
venv
env
.venv

# Development files
tests/
test_*.py
docs/
README.md
CHANGELOG.md
AUTHORS.md
CONTRIBUTORS.md
LICENSE
NOTICE

# Logs
*.log
logs

# Other unnecessary files
*.lock
.env.local
.env.development.local
.env.test.local
.env.production.local
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
